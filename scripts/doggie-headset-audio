#!/usr/bin/env bash
# Select either Doggie's body audio or a paired Bluetooth headset without
# changing any PiDog movement behavior. Never mirror the two outputs: the
# Voice HAT and Bluetooth clocks/sample rates are not safe to combine.
# Run as root; this controls matt's PulseAudio session using its cookie.
set -euo pipefail

readonly AUDIO_USER="${DOGGIE_AUDIO_USER:-matt}"
readonly AUDIO_UID="$(id -u "$AUDIO_USER")"
readonly PULSE_RUNTIME="/run/user/${AUDIO_UID}"
readonly PULSE_COOKIE="/home/${AUDIO_USER}/.config/pulse/cookie"

export XDG_RUNTIME_DIR="$PULSE_RUNTIME"
export PULSE_SERVER="unix:${PULSE_RUNTIME}/pulse/native"
export PULSE_COOKIE

pactl_cmd() {
  pactl "$@"
}

require_pulse() {
  [[ -S "${PULSE_RUNTIME}/pulse/native" ]] || {
    echo "PulseAudio socket is unavailable for ${AUDIO_USER}." >&2
    exit 1
  }
  [[ -r "$PULSE_COOKIE" ]] || {
    echo "PulseAudio cookie is unavailable at ${PULSE_COOKIE}." >&2
    exit 1
  }
  pactl_cmd info >/dev/null
}

normalized_mac() {
  tr ':' '_' <<<"$1" | tr '[:lower:]' '[:upper:]'
}

headset_card() {
  local mac="$1" key
  key="bluez_card.$(normalized_mac "$mac")"
  pactl_cmd list short cards | awk -v key="$key" '$2 == key { print $2; exit }'
}

sink_for_card() {
  local card="$1"
  pactl_cmd list short sinks | awk -v output_prefix="${card/bluez_card/bluez_output}" \
    -v sink_prefix="${card/bluez_card/bluez_sink}" \
    '$2 ~ "^" output_prefix || $2 ~ "^" sink_prefix { print $2; exit }'
}

source_for_card() {
  local card="$1"
  pactl_cmd list short sources | awk -v input_prefix="${card/bluez_card/bluez_input}" \
    -v source_prefix="${card/bluez_card/bluez_source}" \
    '$2 ~ "^" input_prefix || $2 ~ "^" source_prefix { print $2; exit }'
}

remove_legacy_mirror() {
  # Clean up modules created by versions of this script before 2026-08-25.
  pactl_cmd list short modules | awk '$2 == "module-combine-sink" && $0 ~ /sink_name=doggie_mirror/ { print $1 }' |
    while read -r id; do pactl_cmd unload-module "$id"; done
}

body_sink() {
  pactl_cmd list short sinks | awk '$2 ~ /^alsa_output\./ { print $2; exit }'
}

usb_source() {
  pactl_cmd list short sources | awk '$2 ~ /^alsa_input\.usb-/ { print $2; exit }'
}

select_body_audio() {
  local sink source
  remove_legacy_mirror
  sink="$(body_sink)"
  source="$(usb_source)"
  [[ -n "$sink" ]] || { echo "Body speaker sink was not found." >&2; return 1; }
  pactl_cmd set-default-sink "$sink"
  [[ -n "$source" ]] && pactl_cmd set-default-source "$source"
}

enable() {
  local mac="${1:?Bluetooth MAC address is required}"
  local card bt_sink bt_source profile
  require_pulse

  # Establish a safe fallback before touching Bluetooth. If connection or
  # profile negotiation fails, Doggie continues using its body speaker.
  select_body_audio

  bluetoothctl connect "$mac" >/dev/null || true
  sleep 2
  card="$(headset_card "$mac")"
  [[ -n "$card" ]] || {
    echo "No PulseAudio card found for $mac. Pair and connect the headset first." >&2
    exit 1
  }

  # A headset microphone requires an HFP/HSP profile. Sony headsets can take
  # several seconds to expose it after reconnecting, so retry before failing.
  # PulseAudio's native BlueZ module calls it "handsfree_head_unit"; other
  # implementations use either of the hyphenated names below.
  bt_sink=""
  bt_source=""
  for _ in $(seq 1 12); do
    for profile in handsfree_head_unit headset-head-unit-msbc headset-head-unit; do
      pactl_cmd set-card-profile "$card" "$profile" 2>/dev/null || true
    done
    sleep 1
    bt_sink="$(sink_for_card "$card")"
    bt_source="$(source_for_card "$card")"
    [[ -n "$bt_sink" && -n "$bt_source" ]] && break
  done
  [[ -n "$bt_sink" && -n "$bt_source" ]] || {
    echo "The headset connected, but did not expose both a speaker and microphone." >&2
    exit 1
  }

  # Headset mode is exclusive. Combining this telephony-rate Bluetooth sink
  # with the Voice HAT caused clock drift, resampling, and garbled audio.
  pactl_cmd set-default-sink "$bt_sink"
  pactl_cmd set-default-source "$bt_source"
  echo "Headset enabled: mic=${bt_source}; speech=${bt_sink}"
}

status() {
  require_pulse
  pactl_cmd info | grep -E '^Default (Sink|Source):'
  pactl_cmd list short sinks
  pactl_cmd list short cards | grep bluez_card || true
}

disable() {
  require_pulse
  select_body_audio
  echo "Headset routing disabled; restored body speaker and USB microphone."
}

case "${1:-status}" in
  enable) enable "${2:-}" ;;
  disable) disable ;;
  status) status ;;
  *) echo "Usage: $0 {enable BLUETOOTH_MAC|disable|status}" >&2; exit 2 ;;
esac
