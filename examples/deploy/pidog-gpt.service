[Unit]
Description=PiDog ChatGPT Voice Assistant
# No network dependency: Vosk STT and Piper TTS are local (cached in /root),
# and the OpenAI client only needs the network once someone talks to the dog.
# Do not open a second PiDog/I2C session while the short hardware-safe boot
# routine is still initializing the controller.  Starting both services at
# multi-user.target caused an intermittent race on cold boots.
Requires=doggie-boot.service
After=doggie-boot.service sound.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/matt/pidog/examples
ExecStart=/usr/bin/python3 /home/matt/pidog/examples/20_voice_active_dog_gpt.py
Restart=always
RestartSec=5
EnvironmentFile=/etc/doggie/pidog-gpt.env
Environment=PYTHONUNBUFFERED=1
Environment=LOGNAME=matt
# Temporary physical-safety lock: the AI-camera power connector is within the
# head's rear travel. Set this to 1 only after the connector has clearance.
Environment=DOGGIE_HEAD_MOTION_ENABLED=0
UMask=0077
NoNewPrivileges=true
TimeoutStopSec=15
Nice=-10
CPUWeight=800
IOWeight=800
IOSchedulingClass=best-effort
IOSchedulingPriority=0

[Install]
WantedBy=multi-user.target
